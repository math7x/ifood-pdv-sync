{
  "manifest_version": 3,
  "name": "PDV Sync (Saipos → iFood e 99Food)",
  "version": "1.3.6",
  "description": "Casa os códigos da planilha Saipos com os cardápios do iFood e 99Food, com revisão antes de aplicar.",
  "author": "math7x",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://portal.ifood.com.br/*", "https://merchant.99app.com/*", "https://conta.saipos.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "iFood PDV Sync"
  },
  "content_scripts": [
    {
      "matches": ["https://portal.ifood.com.br/menu/list/pdv*"],
      "js": ["lib/xlsx.core.min.js", "matching.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://conta.saipos.com/*"],
      "js": ["saipos.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://merchant.99app.com/pt-BR/manager/micro-merchandish/merchant-item/*"],
      "js": ["matching.js", "food99.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
